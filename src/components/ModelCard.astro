---
import type { CollectionEntry } from 'astro:content';
import { categoryLabels,statusLabels } from '../lib/labels';
const {entry, compact=false}=Astro.props as {entry:CollectionEntry<'motorcycles'>;compact?:boolean}; const m=entry.data;
const power=m.engine.powerKw==null?'—':`${m.engine.powerKw} kW`;
const weight=m.dimensions.wetWeightKg??m.dimensions.dryWeightKg??m.dimensions.weightKg??m.dimensions.weightFullyFueledKg??m.dimensions.weightWithoutFuelKg;
const weightText=weight==null?'—':`${weight} kg`;
const transmission=m.engine.transmission==='cvt'?'CVT':m.engine.transmission==='automatic-belt'?'Automat':m.engine.gearbox?`${m.engine.gearbox} biegów`:'—';
---
<article class="card flex h-full flex-col gap-4" data-model data-category={m.category} data-status={m.status} data-brand={m.brand} data-use={m.useCases.join(',')}>
 <div><div class="flex flex-wrap items-center gap-2"><p class="eyebrow">{categoryLabels[m.category]}</p><span class:list={['badge',m.status==='verify'&&'border-accent text-accent']}>{statusLabels[m.status]}</span></div><h2 class="mt-2 font-serif text-2xl font-bold"><a href={`/motocykle/${m.slug}`}>{m.brand} {m.model}</a></h2></div>
 <p class="text-sm leading-6 text-muted">{m.summary}</p>
 {!compact&&<dl class="grid grid-cols-3 gap-3 border-y border-ink/10 py-3 text-sm"><div><dt class="text-muted">Moc</dt><dd class="font-bold">{power}</dd></div><div><dt class="text-muted">Masa</dt><dd class="font-bold">{weightText}</dd></div><div><dt class="text-muted">Skrzynia</dt><dd class="font-bold">{transmission}</dd></div></dl>}
 <div class="mt-auto flex gap-2"><a class="btn flex-1" href={`/motocykle/${m.slug}`}>Zobacz model</a><a class="btn-alt px-3" aria-label={`Porównaj ${m.brand} ${m.model}`} href={`/porownaj?modele=${m.slug}`}>＋</a></div>
</article>
