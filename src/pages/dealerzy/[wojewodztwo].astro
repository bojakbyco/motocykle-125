---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {dealers} from '../../lib/dealers';
export function getStaticPaths(){return [...new Set(dealers.map(d=>d.region))].map(region=>({params:{wojewodztwo:region},props:{region}}))}
const {region}=Astro.props as {region:string};
const regional=dealers.filter(d=>d.region===region);
---
<BaseLayout title={`Dealerzy motocykli 125 — ${region}`} description={`Zweryfikowane punkty sprzedaży motocykli 125 w województwie ${region}, pozyskane z oficjalnych źródeł marek.`}>
<section class="wrap py-12">
  <p class="eyebrow">{regional.length} punktów · oficjalne źródła</p>
  <h1 class="display mt-3 capitalize">{region}</h1>
  <p class="mt-5 max-w-2xl text-lg text-muted">Przed wizytą skontaktuj się z punktem i potwierdź dostępność konkretnego modelu.</p>
  <div class="mt-8 grid gap-5 lg:grid-cols-2">
    {regional.map(d=><article class="card"><p class="eyebrow">{d.brands.join(' · ')}</p><h2 class="mt-2 font-serif text-2xl font-bold">{d.name}</h2><address class="mt-3 not-italic text-muted">{d.address}<br/>{d.postcode} {d.city}</address><div class="mt-5 flex flex-wrap gap-2">{d.phone&&<a class="btn" href={`tel:${d.phone}`}>Zadzwoń</a>}<a class="btn-alt" href={d.website} target="_blank" rel="nofollow noopener">Strona ↗</a></div><p class="mt-4 text-xs text-muted">Zweryfikowano {d.verifiedAt} · <a class="underline" href={d.source} target="_blank" rel="nofollow noopener">oficjalne źródło</a></p></article>)}
  </div>
  <a class="btn-alt mt-8" href="/dealerzy">Wróć do wszystkich dealerów</a>
</section>
</BaseLayout>
