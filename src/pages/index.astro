---
import { getCollection } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; import ModelCard from '../components/ModelCard.astro';
const models=(await getCollection('motorcycles')).filter(x=>x.data.status==='current-pl').slice(0,6);
---
<BaseLayout title="Motocykle 125 — wybierz model świadomie" description="Polski katalog, porównywarka i kreator wyboru nowych motocykli 125 cm³. Źródła, daty weryfikacji i uczciwe kompromisy.">
 <section class="wrap grid gap-10 py-14 lg:grid-cols-[1.25fr_.75fr] lg:py-24"><div><p class="eyebrow">Przewodnik zakupowy bez marketingowej mgły</p><h1 class="display mt-4 max-w-4xl">Wybierz dobrą 125.<br/><em class="text-accent">Nie zgaduj.</em></h1><p class="mt-7 max-w-2xl text-xl leading-8 text-muted">Porównujemy dane, charakter i realne kompromisy. Każdy rekord ma źródło, status oraz datę weryfikacji.</p><div class="mt-8 flex flex-wrap gap-3"><a class="btn" href="/kreator">Dobierz motocykl w 7 krokach</a><a class="btn-alt" href="/motocykle">Przejrzyj katalog</a></div></div><aside class="border-l-4 border-accent bg-ink p-7 text-white"><p class="eyebrow text-orange-300">Zanim kupisz</p><p class="mt-4 font-serif text-3xl font-bold">15 KM to nie cała historia.</p><p class="mt-4 leading-7 text-white/70">Masa, wysokość siedzenia, ochrona od wiatru i dostępność serwisu często mają większe znaczenie niż różnica na papierze.</p><a class="mt-6 inline-flex text-sm font-bold underline" href="/metodologia">Jak oceniamy modele →</a></aside></section>
 <section class="border-y border-ink/15 bg-white/40 py-8"><div class="wrap grid gap-5 sm:grid-cols-3"><a class="group" href="/dla-kogo/wysoka-osoba"><span class="eyebrow">Ergonomia</span><h2 class="mt-2 font-serif text-2xl font-bold group-hover:text-accent">125 dla wysokiej osoby →</h2></a><a class="group" href="/dla-kogo/adventure-do-15000"><span class="eyebrow">Budżet</span><h2 class="mt-2 font-serif text-2xl font-bold group-hover:text-accent">Adventure do 15 000 zł →</h2></a><a class="group" href="/dla-kogo/dojazdy-do-pracy"><span class="eyebrow">Codzienność</span><h2 class="mt-2 font-serif text-2xl font-bold group-hover:text-accent">Motocykl czy skuter? →</h2></a></div></section>
 <section class="wrap py-16"><div class="flex items-end justify-between gap-5"><div><p class="eyebrow">Punkt startu</p><h2 class="mt-2 font-serif text-4xl font-bold">Aktualne modele w Polsce</h2></div><a class="hidden font-bold underline sm:block" href="/motocykle">Wszystkie modele</a></div><div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">{models.map(m=><ModelCard entry={m}/>)}</div></section>
 <section class="wrap grid gap-8 border-t border-ink/15 py-16 lg:grid-cols-2"><div><p class="eyebrow">Szybka decyzja</p><h2 class="mt-2 font-serif text-4xl font-bold">Trzy modele. Parametr po parametrze.</h2><p class="mt-4 text-muted">Wybierz do trzech motocykli i zobacz różnice bez przekopywania kart producentów.</p><a class="btn mt-6" href="/porownaj">Otwórz porównywarkę</a></div><div><p class="eyebrow">Lokalnie</p><h2 class="mt-2 font-serif text-4xl font-bold">Sprawdź pilotażową bazę dealerów.</h2><p class="mt-4 text-muted">Telefon, strona i trasa w Mapach Google. Bez formularza leadowego i bez ukrytych wyróżnień.</p><a class="btn-alt mt-6" href="/dealerzy">Znajdź dealera</a></div></section>
</BaseLayout>
