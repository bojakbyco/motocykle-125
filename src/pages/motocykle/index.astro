---
import {getCollection} from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import ModelCard from '../../components/ModelCard.astro'; import {categoryLabels} from '../../lib/labels'; const models=(await getCollection('motorcycles')).sort((a,b)=>a.data.brand.localeCompare(b.data.brand,'pl'));
---
<BaseLayout title="Katalog motocykli 125 — modele i dane" description="Katalog nowych motocykli i skuterów 125 z filtrami, źródłami oraz statusem weryfikacji."><section class="wrap py-12"><p class="eyebrow">{models.length} modeli · 8 segmentów</p><h1 class="display mt-3">Katalog 125</h1><p class="mt-5 max-w-2xl text-lg text-muted">Filtruj po charakterze, zastosowaniu i statusie. Brak liczby oznacza brak potwierdzonej wartości — nie estymatę.</p><div class="mt-10 grid gap-8 lg:grid-cols-[250px_1fr]"><aside><form id="filters" class="card sticky top-4 grid gap-5" aria-label="Filtry katalogu"><label class="grid gap-2 font-bold">Szukaj<input id="search" class="border border-ink/30 bg-white p-3 font-normal" type="search" placeholder="Marka lub model"/></label><label class="grid gap-2 font-bold">Segment<select id="category" class="border border-ink/30 bg-white p-3 font-normal"><option value="">Wszystkie</option>{Object.entries(categoryLabels).map(([v,l])=><option value={v}>{l}</option>)}</select></label><label class="grid gap-2 font-bold">Zastosowanie<select id="use" class="border border-ink/30 bg-white p-3 font-normal"><option value="">Wszystkie</option><option value="city">Miasto</option><option value="touring">Turystyka</option><option value="gravel">Szutry</option><option value="light-offroad">Lekki teren</option></select></label><label class="flex min-h-11 items-center gap-3"><input id="verified" class="size-5" type="checkbox"/> Tylko z potwierdzoną ofertą PL</label><button type="reset" class="btn-alt">Wyczyść filtry</button></form></aside><div><p id="count" class="mb-4 text-sm font-bold" aria-live="polite">{models.length} modeli</p><div id="grid" class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">{models.map(m=><ModelCard entry={m}/>)}</div><p id="empty" class="card hidden">Brak modeli dla tych filtrów. Zmień kryteria.</p></div></div></section><script>const form=document.querySelector('#filters');const cards=[...document.querySelectorAll('[data-model]')];const run=()=>{const q=(document.querySelector('#search') as HTMLInputElement).value.toLowerCase();const cat=(document.querySelector('#category') as HTMLSelectElement).value;const use=(document.querySelector('#use') as HTMLSelectElement).value;const verified=(document.querySelector('#verified') as HTMLInputElement).checked;let n=0;cards.forEach((el:any)=>{const ok=el.textContent.toLowerCase().includes(q)&&(!cat||el.dataset.category===cat)&&(!use||el.dataset.use.includes(use))&&(!verified||el.dataset.status==='current-pl');el.hidden=!ok;if(ok)n++});document.querySelector('#count')!.textContent=`${n} modeli`;document.querySelector('#empty')!.classList.toggle('hidden',n>0)};form?.addEventListener('input',run);form?.addEventListener('reset',()=>setTimeout(run));</script></BaseLayout>
