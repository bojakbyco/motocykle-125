---
import {getCollection} from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; const entries=await getCollection('motorcycles'); const models=entries.map(e=>e.data);
---
<BaseLayout title="Porównaj motocykle 125 — do 3 modeli" description="Porównaj parametry, zastosowanie i ograniczenia maksymalnie trzech motocykli 125."><section class="wrap py-12"><p class="eyebrow">Maksymalnie 3 modele</p><h1 class="display mt-3">Porównywarka</h1><p class="mt-5 max-w-2xl text-lg text-muted">Wybierz motocykle. Masa sucha i mokra nigdy nie są przedstawiane jako ta sama wartość.</p><form id="picker" class="mt-8 grid gap-3 sm:grid-cols-3">{[0,1,2].map(i=><label class="grid gap-2 font-bold">Model {i+1}<select class="model-select border border-ink/30 bg-white p-3 font-normal"><option value="">— wybierz —</option>{models.map(m=><option value={m.slug}>{m.brand} {m.model}</option>)}</select></label>)}</form><p id="hint" class="mt-5 text-sm text-muted" aria-live="polite"></p><div id="comparison" class="mt-8 overflow-x-auto"></div></section><script define:vars={{models}}>const selects=[...document.querySelectorAll('.model-select')];const params=new URLSearchParams(location.search);const initial=(params.get('modele')||'').split(',').filter(Boolean).slice(0,3);initial.forEach((v,i)=>selects[i].value=v);const val=(x,s='')=>x==null?'—':`${x}${s}`;const render=()=>{const ids=selects.map(s=>s.value).filter(Boolean);selects.forEach(s=>[...s.options].forEach(o=>o.disabled=!!o.value&&ids.includes(o.value)&&o.value!==s.value));history.replaceState({},'',ids.length?`?modele=${ids.join(',')}`:location.pathname);const chosen=ids.map(id=>models.find(m=>m.slug===id));document.querySelector('#hint').textContent=chosen.length?'Różnice są podkreślone kolorem. „—” oznacza brak potwierdzonej wartości.':'Wybierz pierwszy model, aby rozpocząć.';const rows=[['Status',m=>m.status],['Rocznik',m=>val(m.marketYear)],['Segment',m=>m.category],['Moc',m=>m.engine.powerKw==null?'—':val(m.engine.powerKw,' kW')],['Skrzynia',m=>m.engine.transmission==='cvt'?'CVT':m.engine.transmission==='automatic-belt'?'automat z pasem':val(m.engine.gearbox,' biegów')],['ABS',m=>m.chassis.abs],['Masa',m=>m.dimensions.wetWeightKg?`${m.dimensions.wetWeightKg} kg (mokro)`:m.dimensions.dryWeightKg?`${m.dimensions.dryWeightKg} kg (sucho)`:m.dimensions.weightKg?`${m.dimensions.weightKg} kg (${m.dimensions.weightDefinition})`:m.dimensions.weightWithoutFuelKg?`${m.dimensions.weightWithoutFuelKg}/${m.dimensions.weightFullyFueledKg} kg (bez paliwa/z paliwem)`:'—'],['Siedzenie',m=>val(m.dimensions.seatHeightMm,' mm')],['Koła przód / tył',m=>`${val(m.chassis.frontWheelIn,'″')} / ${val(m.chassis.rearWheelIn,'″')}`],['Miasto',m=>`${m.editorial.cityAgility}/5`],['Turystyka',m=>`${m.editorial.touringReadiness}/5`],['Szutry',m=>`${m.editorial.gravelReadiness}/5`],['Ograniczenie',m=>m.editorial.limitations[0]]];const different=(values)=>new Set(values).size>1;document.querySelector('#comparison').innerHTML=!chosen.length?'':`<table class="min-w-[760px] w-full border-collapse text-left"><thead><tr><th class="sticky left-0 z-10 bg-ink p-4 text-white">Parametr</th>${chosen.map(m=>`<th class="min-w-56 bg-ink p-4 text-white"><a class="underline" href="/motocykle/${m.slug}">${m.brand}<br><span class="font-serif text-xl">${m.model}</span></a></th>`).join('')}</tr></thead><tbody>${rows.map(([label,get])=>{const values=chosen.map(get);const diff=different(values);return `<tr><th class="sticky left-0 z-10 border-b border-ink/15 bg-paper p-4">${label}</th>${values.map(v=>`<td class="border-b border-ink/15 p-4 ${diff?'font-bold text-accent':''}">${v}</td>`).join('')}</tr>`}).join('')}</tbody></table>`;window.dispatchEvent(new CustomEvent('m125:analytics',{detail:{event:'compare_opened',properties:{models:ids}}}))};selects.forEach(s=>s.addEventListener('change',render));render();</script></BaseLayout>
