---
import {getCollection} from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; const models=(await getCollection('motorcycles')).map(e=>e.data);
---
<BaseLayout title="Kreator: jaka 125 dla mnie?" description="Odpowiedz na 7 pytań i poznaj trzy dopasowane motocykle 125 wraz z kompromisami." noindex={Astro.url.searchParams.has('wynik')}><section class="wrap py-12"><div class="max-w-3xl"><p class="eyebrow">60–90 sekund · bez rejestracji</p><h1 class="display mt-3">Jaka 125<br/><em class="text-accent">dla mnie?</em></h1><p class="mt-5 text-lg text-muted">Wynik opiera się na twardych filtrach i jawnych wagach. Modele ze statusem „do weryfikacji” nie trafiają do rekomendacji.</p></div><div id="quiz" class="mt-10 max-w-3xl"><div class="mb-5 flex items-center gap-4"><div class="h-2 flex-1 bg-ink/10"><div id="progress" class="h-full bg-accent" style="width:14%"></div></div><span id="step-label" class="text-sm font-bold">1 / 7</span></div><form id="quiz-form"></form><div class="mt-6 flex justify-between"><button id="back" class="btn-alt invisible" type="button">← Wstecz</button><button id="next" class="btn" type="button">Dalej →</button></div></div><div id="results" class="mt-12 hidden"></div></section><script define:vars={{models}}>const questions=[{key:'licence',title:'Jakie masz uprawnienia?',options:[['b3','Prawo jazdy B od min. 3 lat'],['a1','Prawo jazdy A1'],['other','Inne lub brak pewności']]},{key:'use',title:'Gdzie będziesz jeździć najczęściej?',options:[['city','Miasto'],['commute','Dojazdy do pracy'],['weekend','Weekendowe trasy'],['touring','Turystyka'],['gravel','Szutry'],['light-offroad','Lekki teren']]},{key:'surface',title:'Jaka nawierzchnia dominuje?',options:[['road','90% asfalt'],['mixed','Asfalt i szutry'],['offroad','Często drogi polne']]},{key:'budget',title:'Jaki masz budżet na motocykl?',options:[['10','Do 10 000 zł'],['15','10–15 000 zł'],['20','15–20 000 zł'],['25','20–25 000 zł'],['open','Bez sztywnego limitu']]},{key:'height',title:'Jaki masz wzrost?',options:[['short','Do 170 cm'],['average','171–184 cm'],['tall','185–194 cm'],['very-tall','195 cm i więcej']]},{key:'passenger',title:'Pasażer i bagaż?',options:[['solo','Głównie solo'],['sometimes','Czasem pasażer'],['touring','Kufry i wyjazdy']]},{key:'priority',title:'Co jest najważniejsze?',options:[['beginner','Łatwość dla początkującego'],['performance','Osiągi'],['cost','Niski koszt'],['upright','Wyprostowana pozycja'],['style','Styl'],['offroad','Jazda poza asfaltem']]}];let step=0;let answers={};const form=document.querySelector('#quiz-form');const next=document.querySelector('#next');const back=document.querySelector('#back');const budgets={10:10000,15:15000,20:20000,25:25000,open:Infinity};const surfaces={road:['naked','sport','scrambler','cruiser','scooter','adventure'],mixed:['adventure','dual-sport','scrambler'],offroad:['dual-sport','enduro','adventure']};const render=()=>{const q=questions[step];form.innerHTML=`<fieldset><legend class="font-serif text-3xl font-bold">${q.title}</legend><div class="mt-6 grid gap-3 sm:grid-cols-2">${q.options.map(([v,l])=>`<label class="flex min-h-14 cursor-pointer items-center gap-3 border border-ink/25 bg-white/50 p-4 font-bold has-[:checked]:border-accent has-[:checked]:bg-orange-50"><input class="size-5" type="radio" name="${q.key}" value="${v}" ${answers[q.key]===v?'checked':''}>${l}</label>`).join('')}</div></fieldset>`;document.querySelector('#progress').style.width=`${(step+1)/7*100}%`;document.querySelector('#step-label').textContent=`${step+1} / 7`;back.classList.toggle('invisible',step===0);next.textContent=step===6?'Pokaż rekomendacje':'Dalej →'};const score=m=>{const a=answers;const use=m.useCases.includes(a.use)?1:(['city','commute'].includes(a.use)&&m.useCases.some(x=>['city','commute'].includes(x)))?.7:.25;const surface=surfaces[a.surface].includes(m.category)?1:a.surface==='road'&&m.category!=='enduro'?.7:.2;const lim=budgets[a.budget];const budget=!m.price?.55:lim===Infinity?.9:m.price.amount<=lim?Math.max(.6,1-m.price.amount/lim*.25):0;const ergo=(a.height==='tall'||a.height==='very-tall'?m.editorial.tallRiderFit:m.editorial.beginnerFriendliness)/5;const luggage=a.passenger==='solo'?.8:a.passenger==='sometimes'?m.editorial.passengerComfort/5:(m.editorial.passengerComfort+m.editorial.touringReadiness)/10;const experience=a.priority==='beginner'?m.editorial.beginnerFriendliness/5:.75;const priority=a.priority==='offroad'?m.editorial.gravelReadiness/5:a.priority==='upright'?m.editorial.touringReadiness/5:a.priority==='performance'?Math.min(1,m.engine.powerKw/11):.75;return Math.round((.27*use+.18*surface+.16*budget+.12*ergo+.10*luggage+.09*experience+.08*priority)*20)*5};const finish=()=>{const eligible=models.filter(m=>answers.licence!=='other'&&!['verify','used-reference'].includes(m.status)&&!(answers.surface==='offroad'&&!surfaces.offroad.includes(m.category))&&(!m.price||m.price.amount<=budgets[answers.budget]));const ranked=eligible.map(m=>({m,score:score(m)})).sort((a,b)=>b.score-a.score).slice(0,4);document.querySelector('#quiz').classList.add('hidden');const result=document.querySelector('#results');result.classList.remove('hidden');const top=ranked.slice(0,3);if(!top.length){result.innerHTML='<div class="card"><h2 class="font-serif text-3xl font-bold">Najpierw sprawdź uprawnienia</h2><p class="mt-4">Nie możemy uczciwie polecić pojazdu bez potwierdzenia uprawnień lub przy tak wąskich filtrach.</p><a class="btn mt-6" href="/metodologia">Przeczytaj o ograniczeniach</a></div>';return}const why=m=>[m.useCases.includes(answers.use)?'pasuje do głównego zastosowania':'daje rozsądny kompromis zastosowań',(answers.height==='tall'||answers.height==='very-tall')&&m.editorial.tallRiderFit>=4?'wysoko oceniona ergonomia dla wysokich':'przyjazna charakterystyka',answers.surface!=='road'&&m.editorial.gravelReadiness>=4?'dobry potencjał na szuter':'przewidywalna na asfalcie'];result.innerHTML=`<p class="eyebrow">Twój wynik</p><h2 class="mt-2 font-serif text-4xl font-bold">${answers.surface==='road'?'Głównie asfalt':answers.surface==='mixed'?'Asfalt i szutry':'Często poza asfaltem'} · ${answers.passenger==='solo'?'solo':'z pasażerem lub bagażem'}</h2><div class="mt-7 grid gap-5 lg:grid-cols-3">${top.map(({m,score},i)=>`<article class="card"><span class="eyebrow">${i+1}. dopasowanie ${score}%</span><h3 class="mt-2 font-serif text-2xl font-bold"><a href="/motocykle/${m.slug}">${m.brand} ${m.model}</a></h3><ul class="mt-4 list-disc pl-5 text-sm leading-6">${why(m).map(x=>`<li>${x}</li>`).join('')}</ul><p class="mt-4 border-t border-ink/15 pt-4 text-sm"><strong>Kompromis:</strong> ${m.editorial.limitations[0]}</p><p class="mt-2 text-sm text-muted"><strong>Nie dla Ciebie, jeśli:</strong> ten kompromis dotyczy głównego zastosowania.</p></article>`).join('')}</div>${ranked[3]?`<p class="mt-5 text-sm"><strong>Warto też rozważyć:</strong> <a class="underline" href="/motocykle/${ranked[3].m.slug}">${ranked[3].m.brand} ${ranked[3].m.model}</a>, jeśli zaakceptujesz: ${ranked[3].m.editorial.limitations[0]}</p>`:''}<div class="mt-7 flex flex-wrap gap-3"><a class="btn" href="/porownaj?modele=${top.map(x=>x.m.slug).join(',')}">Porównaj te ${top.length}</a><a class="btn-alt" href="/dealerzy">Znajdź dealera</a><button id="share" class="btn-alt">Skopiuj link</button></div>`;const encoded=btoa(encodeURIComponent(JSON.stringify(answers)));history.replaceState({},'',`?wynik=${encoded}`);document.querySelector('#share')?.addEventListener('click',()=>navigator.clipboard.writeText(location.href));window.dispatchEvent(new CustomEvent('m125:analytics',{detail:{event:'quiz_completed',properties:{models:top.map(x=>x.m.slug)}}}))};next.addEventListener('click',()=>{const checked=form.querySelector('input:checked');if(!checked){form.querySelector('fieldset').classList.add('outline','outline-2','outline-accent');return}answers[questions[step].key]=checked.value;if(step<6){step++;render()}else finish()});back.addEventListener('click',()=>{if(step){step--;render()}});const state=new URLSearchParams(location.search).get('wynik');if(state){try{answers=JSON.parse(decodeURIComponent(atob(state)));if(questions.every(q=>answers[q.key]))finish();else render()}catch{render()}}else{render();window.dispatchEvent(new CustomEvent('m125:analytics',{detail:{event:'quiz_started',properties:{}}}))}</script></BaseLayout>
