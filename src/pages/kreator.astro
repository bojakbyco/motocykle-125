---
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const models = (await getCollection('motorcycles')).map((entry) => entry.data);
---

<BaseLayout
  title="Kreator: jaka 125 dla mnie?"
  description="Odpowiedz na 5 konkretnych pytań i poznaj trzy dopasowane motocykle 125 wraz z kompromisami."
  noindex={Astro.url.searchParams.has('wynik')}
>
  <section class="wrap py-12">
    <div class="max-w-3xl">
      <p class="eyebrow">45–60 sekund · bez rejestracji</p>
      <h1 class="display mt-3">Jaka 125<br/><em class="text-accent">dla mnie?</em></h1>
      <p class="mt-5 text-lg text-muted">
        Pięć konkretnych pytań o sposób jazdy, budżet i ergonomię. Modele ze statusem „do weryfikacji” nie trafiają do rekomendacji.
      </p>
    </div>

    <aside class="card mt-8 max-w-3xl" aria-labelledby="licence-heading">
      <p class="eyebrow">Zanim wybierzesz</p>
      <h2 id="licence-heading" class="mt-2 font-serif text-2xl font-bold">Co uprawnia do kierowania motocyklem 125?</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-6">
        <li><strong>A1</strong> — motocykl do 125 cm³, do 11 kW i do 0,1 kW/kg.</li>
        <li><strong>B od co najmniej 3 lat</strong> — taki sam motocykl, ale to uprawnienie obowiązuje tylko w Polsce.</li>
        <li><strong>A2 lub A</strong> — również uprawnia do kierowania motocyklem 125.</li>
      </ul>
      <p class="mt-4 text-sm text-muted">
        To informacja, a nie pytanie kwalifikujące. Kreator dobiera pojazd, ale przed jazdą sprawdź swoje uprawnienia.
        <a class="font-bold underline" href="https://www.gov.pl/web/gov/kategorie-prawa-jazdy" rel="noreferrer" target="_blank">Źródło: gov.pl</a>
      </p>
    </aside>

    <div id="quiz-app" data-models={JSON.stringify(models)}>
      <div id="quiz" class="mt-10 max-w-3xl">
        <div class="mb-5 flex items-center gap-4">
          <div class="h-2 flex-1 bg-ink/10"><div id="progress" class="h-full bg-accent" style="width:20%"></div></div>
          <span id="step-label" class="text-sm font-bold">1 / 5</span>
        </div>
        <form id="quiz-form"></form>
        <div class="mt-6 flex justify-between">
          <button id="back" class="btn-alt invisible" type="button">← Wstecz</button>
          <button id="next" class="btn" type="button">Dalej →</button>
        </div>
      </div>
      <div id="results" class="mt-12 hidden"></div>
    </div>
  </section>

  <script>
    import {quizQuestions, ridingProfiles} from '../lib/quiz-config';
    import {recommend} from '../lib/recommendation';
    import type {Motorcycle, QuizAnswers} from '../types';

    const app = document.querySelector<HTMLElement>('#quiz-app');
    const form = document.querySelector<HTMLFormElement>('#quiz-form');
    const next = document.querySelector<HTMLButtonElement>('#next');
    const back = document.querySelector<HTMLButtonElement>('#back');
    const quiz = document.querySelector<HTMLElement>('#quiz');
    const results = document.querySelector<HTMLElement>('#results');
    const progress = document.querySelector<HTMLElement>('#progress');
    const stepLabel = document.querySelector<HTMLElement>('#step-label');

    if (!app || !form || !next || !back || !quiz || !results || !progress || !stepLabel) {
      throw new Error('Nie udało się uruchomić kreatora.');
    }

    const models = JSON.parse(app.dataset.models ?? '[]') as Motorcycle[];
    let step = 0;
    let answers: Partial<QuizAnswers> = {};

    const render = () => {
      const question = quizQuestions[step];
      form.innerHTML = `<fieldset><legend class="font-serif text-3xl font-bold">${question.title}</legend><div class="mt-6 grid gap-3 sm:grid-cols-2">${question.options.map(([value, label]) => `<label class="flex min-h-14 cursor-pointer items-center gap-3 border border-ink/25 bg-white/50 p-4 font-bold has-[:checked]:border-accent has-[:checked]:bg-orange-50"><input class="size-5" type="radio" name="${question.key}" value="${value}" ${answers[question.key] === value ? 'checked' : ''}>${label}</label>`).join('')}</div></fieldset>`;
      progress.style.width = `${((step + 1) / quizQuestions.length) * 100}%`;
      stepLabel.textContent = `${step + 1} / ${quizQuestions.length}`;
      back.classList.toggle('invisible', step === 0);
      next.textContent = step === quizQuestions.length - 1 ? 'Pokaż rekomendacje' : 'Dalej →';
    };

    const profileLabels: Record<QuizAnswers['ridingProfile'], string> = {
      city: 'Miasto i codzienne dojazdy',
      weekend: 'Weekendowe trasy po asfalcie',
      touring: 'Dłuższa turystyka',
      mixed: 'Asfalt i szutry',
      offroad: 'Drogi polne i lekki teren',
    };

    const typeLabel = (motorcycle: Motorcycle) => motorcycle.category === 'scooter'
      ? 'automatyczna przekładnia skutera'
      : 'motocykl z manualną skrzynią';

    const finish = () => {
      const completeAnswers = answers as QuizAnswers;
      const ranked = recommend(models, completeAnswers);
      quiz.classList.add('hidden');
      results.classList.remove('hidden');
      const top = ranked.slice(0, 3);

      if (!top.length) {
        results.innerHTML = '<div class="card"><h2 class="font-serif text-3xl font-bold">Brak modeli dla tych filtrów</h2><p class="mt-4">Zmień budżet albo wybierz „Nie mam preferencji” przy pytaniu o motocykl lub skuter.</p><button id="restart" class="btn mt-6" type="button">Zmień odpowiedzi</button></div>';
        document.querySelector('#restart')?.addEventListener('click', () => {
          results.classList.add('hidden');
          quiz.classList.remove('hidden');
          step = 0;
          render();
        });
        return;
      }

      const profile = ridingProfiles[completeAnswers.ridingProfile];
      const why = (motorcycle: Motorcycle) => {
        const reasons = [
          motorcycle.useCases.includes(profile.useCase)
            ? 'zastosowanie modelu pasuje do wybranego profilu jazdy'
            : 'najbliższy dostępny kompromis dla wybranego profilu',
          motorcycle.dimensions.seatHeightMm
            ? `wysokość siedzenia ${motorcycle.dimensions.seatHeightMm} mm została uwzględniona przy Twoim wzroście`
            : 'brak potwierdzonej wysokości siedzenia obniża pewność dopasowania ergonomii',
          typeLabel(motorcycle),
        ];
        if (completeAnswers.ridingProfile === 'mixed' || completeAnswers.ridingProfile === 'offroad') {
          reasons.push(motorcycle.editorial.gravelReadiness >= 4
            ? 'konstrukcja jest oceniona jako odpowiednia na szuter'
            : 'jazda poza asfaltem będzie kompromisem');
        }
        return reasons;
      };

      results.innerHTML = `<p class="eyebrow">Twój wynik</p><h2 class="mt-2 font-serif text-4xl font-bold">${profileLabels[completeAnswers.ridingProfile]} · ${completeAnswers.passenger === 'solo' ? 'solo' : 'z pasażerem lub bagażem'}</h2><div class="mt-7 grid gap-5 lg:grid-cols-3">${top.map(({motorcycle, score}, index) => `<article class="card"><span class="eyebrow">${index + 1}. dopasowanie ${score}%</span><h3 class="mt-2 font-serif text-2xl font-bold"><a href="/motocykle/${motorcycle.slug}">${motorcycle.brand} ${motorcycle.model}</a></h3><ul class="mt-4 list-disc pl-5 text-sm leading-6">${why(motorcycle).map((reason) => `<li>${reason}</li>`).join('')}</ul><p class="mt-4 border-t border-ink/15 pt-4 text-sm"><strong>Kompromis:</strong> ${motorcycle.editorial.limitations[0]}</p></article>`).join('')}</div>${ranked[3] ? `<p class="mt-5 text-sm"><strong>Warto też rozważyć:</strong> <a class="underline" href="/motocykle/${ranked[3].motorcycle.slug}">${ranked[3].motorcycle.brand} ${ranked[3].motorcycle.model}</a>, jeśli zaakceptujesz: ${ranked[3].motorcycle.editorial.limitations[0]}</p>` : ''}<div class="mt-7 flex flex-wrap gap-3"><a class="btn" href="/porownaj?modele=${top.map(({motorcycle}) => motorcycle.slug).join(',')}">Porównaj te ${top.length}</a><a class="btn-alt" href="/dealerzy">Znajdź dealera</a><button id="share" class="btn-alt">Skopiuj link</button></div>`;

      const encoded = btoa(encodeURIComponent(JSON.stringify(completeAnswers)));
      history.replaceState({}, '', `?wynik=${encoded}`);
      document.querySelector('#share')?.addEventListener('click', () => navigator.clipboard.writeText(location.href));
      window.dispatchEvent(new CustomEvent('m125:analytics', {detail: {event: 'quiz_completed', properties: {models: top.map(({motorcycle}) => motorcycle.slug)}}}));
    };

    next.addEventListener('click', () => {
      const checked = form.querySelector<HTMLInputElement>('input:checked');
      if (!checked) {
        form.querySelector('fieldset')?.classList.add('outline', 'outline-2', 'outline-accent');
        return;
      }
      const question = quizQuestions[step];
      (answers as Record<string, string>)[question.key] = checked.value;
      if (step < quizQuestions.length - 1) {
        step += 1;
        render();
      } else {
        finish();
      }
    });

    back.addEventListener('click', () => {
      if (step) {
        step -= 1;
        render();
      }
    });

    const state = new URLSearchParams(location.search).get('wynik');
    if (state) {
      try {
        answers = JSON.parse(decodeURIComponent(atob(state))) as Partial<QuizAnswers>;
        if (quizQuestions.every((question) => answers[question.key])) finish();
        else render();
      } catch {
        render();
      }
    } else {
      render();
      window.dispatchEvent(new CustomEvent('m125:analytics', {detail: {event: 'quiz_started', properties: {}}}));
    }
  </script>
</BaseLayout>
