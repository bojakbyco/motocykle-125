---
import '../styles/global.css';
interface Props { title:string; description:string; noindex?:boolean; image?:string; jsonLd?:Record<string,unknown> }
const {title,description,noindex=false,image='/og.svg',jsonLd}=Astro.props;
const canonical=new URL(Astro.url.pathname, Astro.site);
const analyticsKey=import.meta.env.PUBLIC_ANALYTICS_KEY;
---
<!doctype html><html lang="pl"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#f6f1e8"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex&&<meta name="robots" content="noindex,follow"/>}<meta property="og:type" content="website"/><meta property="og:locale" content="pl_PL"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,Astro.site)}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" href="/favicon.svg"/>{jsonLd&&<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>}<script is:inline define:vars={{analyticsKey}}>window.analytics=window.analytics||{track:(e,p)=>{if(analyticsKey)navigator.sendBeacon?.('/analytics',JSON.stringify({e,p,key:analyticsKey}))}};</script></head>
<body><a href="#tresc" class="sr-only focus:not-sr-only focus:fixed focus:z-50 focus:bg-white focus:p-3">Przejdź do treści</a><header class="border-b border-ink/15"><div class="wrap flex min-h-18 items-center justify-between gap-5"><a href="/" class="flex items-center gap-2 font-black tracking-tight" aria-label="Motocykle 125 — strona główna"><span class="grid size-9 place-items-center bg-accent text-white">125</span> MOTOCYKLE</a><nav aria-label="Główna" class="hidden items-center gap-6 text-sm font-bold md:flex"><a href="/motocykle">Katalog</a><a href="/kreator">Kreator</a><a href="/porownaj">Porównaj</a><a href="/dealerzy">Dealerzy</a><a href="/poradniki">Poradniki</a></nav><details class="md:hidden"><summary class="flex min-h-11 cursor-pointer list-none items-center px-2 font-bold">Menu</summary><nav class="absolute right-4 z-40 grid w-52 border border-ink/20 bg-paper p-3 shadow-xl"><a class="p-3" href="/motocykle">Katalog</a><a class="p-3" href="/kreator">Kreator</a><a class="p-3" href="/porownaj">Porównaj</a><a class="p-3" href="/dealerzy">Dealerzy</a><a class="p-3" href="/poradniki">Poradniki</a></nav></details></div></header><main id="tresc"><slot/></main><footer class="mt-20 border-t border-ink/15 py-10"><div class="wrap grid gap-8 md:grid-cols-3"><div><div class="font-black">MOTOCYKLE 125</div><p class="mt-2 text-sm text-muted">Niezależny, uczciwy przewodnik zakupowy. Dane nie są ofertą handlową.</p></div><nav class="grid text-sm"><a href="/metodologia">Metodologia i źródła</a><a href="/poradniki">Poradniki</a><a href="/dealerzy">Dealerzy</a></nav><p class="text-sm text-muted">© {new Date().getFullYear()} Motocykle 125<br/>Zawsze potwierdź dane u producenta lub dealera.</p></div></footer></body></html>
